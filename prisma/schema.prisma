// Dubai Land Department (DLD / RERA) brokerage + broker registry mirror.
//
// Source of truth is the public gateway at gateway.dubailand.gov.ae:
//   GET /offices/  -> every licensed real-estate brokerage  (~10.2k)
//   GET /brokers/  -> every licensed broker card            (~34k)
//
// The registry itself has no "created at" concept, so every row carries
// firstSeenAt / lastSeenAt written by our sync. That is what lets us tell a
// genuinely new licence apart from a renewal of an old one.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Office {
  realEstateNumber String  @id
  licenseNumber    String?

  nameEn String?
  nameAr String?

  /// Original RERA licence issue date for the brokerage. This is the field that
  /// answers "which brokerages just opened".
  issueDate  DateTime? @db.Timestamptz(3)
  expiryDate DateTime? @db.Timestamptz(3)

  phone   String?
  fax     String?
  website String?

  contactNameEn String?
  contactNameAr String?
  contactMobile String?
  contactEmail  String?

  logo        String?
  rankId      Int?
  rank        String?
  awardsCount Int     @default(0)

  youtubeUrl   String?
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  linkedinUrl  String?
  whatsapp     String?

  /// [{ id, nameEn, nameAr }] straight from the gateway.
  activities Json?

  // ---- denormalised rollups, recomputed at the end of each sync ----
  brokerCount       Int       @default(0)
  activeBrokerCount Int       @default(0)
  newBrokers30d     Int       @default(0)
  newBrokers90d     Int       @default(0)
  firstCardIssuedAt DateTime? @db.Timestamptz(3)
  lastCardIssuedAt  DateTime? @db.Timestamptz(3)

  // ---- our own observation window ----
  /// First sync in which this brokerage appeared. For anything registered after
  /// we went live this is effectively the discovery date.
  firstSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(3)
  /// False once the brokerage stops appearing in the registry (licence dropped).
  isActive    Boolean   @default(true)
  deactivatedAt DateTime? @db.Timestamptz(3)

  leadScore Int     @default(0)
  leadTier  String  @default("D")

  // ---- CRM overlay ----
  // Owned by humans in Notion. The registry sync never writes these; the Notion
  // sync pulls them back. `status` holds the Notion Stage string verbatim so
  // there is exactly one pipeline vocabulary across the whole system.
  status          String    @default("🆕 New Lead")
  ownerNote       String?
  contactedAt     DateTime? @db.Timestamptz(3)
  ownerName       String?
  ownerNotionId   String?
  channel         String?
  touchpoints     Int       @default(0)
  nextAction      String?
  nextActionDate  DateTime? @db.Timestamptz(3)
  clientPotential String?
  servicesInterest Json?
  lostReason      String?
  dealValueAed    Int?

  // ---- batching ----
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // ---- Notion mirror ----
  notionPageId   String?   @unique
  notionSyncedAt DateTime? @db.Timestamptz(3)
  /// Hash of the last payload we pushed. Lets the sync skip unchanged rows
  /// instead of burning Notion's rate limit rewriting identical values.
  notionHash     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  brokers Broker[]
  changes OfficeChange[]

  @@index([issueDate])
  @@index([firstSeenAt])
  @@index([expiryDate])
  @@index([isActive, issueDate])
  @@index([leadScore])
  @@index([status])
  @@index([nameEn])
  @@index([batchId])
  @@index([notionSyncedAt])
  @@map("offices")
}

model Broker {
  cardNumber String @id

  nameEn String?
  nameAr String?

  /// Issue date of the *current* card. Renewals move this forward, so on its own
  /// it does not mean "new broker" - pair it with firstSeenAt / isNewCard.
  cardIssueDate  DateTime? @db.Timestamptz(3)
  cardExpiryDate DateTime? @db.Timestamptz(3)

  phone  String?
  mobile String?
  email  String?

  realEstateNumber String?
  licenseNumber    String?
  officeNameEn     String?
  officeNameAr     String?
  officeIssueDate  DateTime? @db.Timestamptz(3)
  officeExpiryDate DateTime? @db.Timestamptz(3)

  photo       String?
  cardRankId  Int?
  cardRank    String?
  officeRankId Int?
  officeRank  String?
  awardsCount Int     @default(0)

  /// True when this card's number was above the highest number the registry had
  /// ever shown us before the sync that first saw it - i.e. a first-time licence
  /// rather than an annual renewal of an older card.
  ///
  /// This is the only sound new-vs-renewal test available. The registry
  /// publishes just the current term, so `cardIssueDate` moves on every renewal,
  /// and card numbers are only *broadly* chronological - a handful carry dates
  /// decades out of line with their neighbours, which defeats any attempt to
  /// reconstruct original issue dates from the numbering alone. Comparing
  /// against a watermark we recorded ourselves sidesteps that entirely, at the
  /// cost of only being meaningful from the second sync onward.
  isNewCard Boolean @default(false)

  firstSeenAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  isActive      Boolean   @default(true)
  deactivatedAt DateTime? @db.Timestamptz(3)

  // ---- lead scoring (inherited from the firm, adjusted for card recency) ----
  leadScore Int    @default(0)
  leadTier  String @default("D")

  // ---- CRM overlay, human-owned in Notion (see Office for the contract) ----
  status          String    @default("🆕 New Lead")
  ownerNote       String?
  contactedAt     DateTime? @db.Timestamptz(3)
  ownerName       String?
  ownerNotionId   String?
  channel         String?
  touchpoints     Int       @default(0)
  nextAction      String?
  nextActionDate  DateTime? @db.Timestamptz(3)
  clientPotential String?
  lostReason      String?

  // ---- batching ----
  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // ---- Notion mirror ----
  notionPageId   String?   @unique
  notionSyncedAt DateTime? @db.Timestamptz(3)
  notionHash     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  office  Office?        @relation(fields: [realEstateNumber], references: [realEstateNumber], onDelete: SetNull)
  changes BrokerChange[]

  @@index([cardIssueDate])
  @@index([firstSeenAt])
  @@index([cardExpiryDate])
  @@index([realEstateNumber])
  @@index([isActive, cardIssueDate])
  @@index([isNewCard])
  @@index([nameEn])
  @@index([leadScore])
  @@index([batchId])
  @@index([status])
  @@map("brokers")
}

/// Field-level audit of everything the registry changed on a brokerage:
/// renewals, contact-detail edits, rank upgrades, office moves.
model OfficeChange {
  id               String   @id @default(cuid())
  realEstateNumber String
  field            String
  oldValue         String?
  newValue         String?
  detectedAt       DateTime @default(now()) @db.Timestamptz(3)
  syncRunId        String?

  office  Office   @relation(fields: [realEstateNumber], references: [realEstateNumber], onDelete: Cascade)
  syncRun SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@index([realEstateNumber])
  @@index([detectedAt])
  @@index([field])
  @@map("office_changes")
}

model BrokerChange {
  id         String   @id @default(cuid())
  cardNumber String
  field      String
  oldValue   String?
  newValue   String?
  detectedAt DateTime @default(now()) @db.Timestamptz(3)
  syncRunId  String?

  broker  Broker   @relation(fields: [cardNumber], references: [cardNumber], onDelete: Cascade)
  syncRun SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@index([cardNumber])
  @@index([detectedAt])
  @@index([field])
  @@map("broker_changes")
}

model SyncRun {
  id     String  @id @default(cuid())
  /// FULL | INCREMENTAL | BACKFILL
  kind   String
  /// RUNNING | SUCCESS | FAILED | PARTIAL
  status String  @default("RUNNING")
  /// MANUAL | SCHEDULED | API
  trigger String @default("MANUAL")

  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  durationMs Int?

  officesSeen       Int @default(0)
  officesNew        Int @default(0)
  officesUpdated    Int @default(0)
  officesDeactivated Int @default(0)

  brokersSeen        Int @default(0)
  brokersNew         Int @default(0)
  brokersUpdated     Int @default(0)
  brokersDeactivated Int @default(0)

  requestCount Int @default(0)
  errorCount   Int @default(0)
  error        String?
  /// Free-form per-stage notes so a failed run is debuggable after the fact.
  log          Json?

  officeChanges OfficeChange[]
  brokerChanges BrokerChange[]

  @@index([startedAt])
  @@index([status])
  @@map("sync_runs")
}

/// One row per calendar day, rebuilt after every sync. Powers the date-wise
/// table and charts without scanning the whole registry on each page load.
model DailyStat {
  date DateTime @id @db.Date

  /// Brokerages whose RERA issue date is this day.
  officesIssued Int @default(0)
  /// Brokerages our sync discovered on this day.
  officesDiscovered Int @default(0)
  officesExpiring   Int @default(0)

  /// Every broker card the registry stamped this day. Includes annual renewals,
  /// which on a typical day outnumber genuinely new brokers several times over.
  brokerCardsIssued Int @default(0)
  /// Of those, cards whose number cleared our high-water mark - genuinely new
  /// brokers. Zero for every day before our first sync, by construction.
  brokersNew        Int @default(0)
  /// Broker cards our sync saw for the first time this day.
  brokersDiscovered Int @default(0)
  brokerCardsExpiring Int @default(0)

  /// Brokerages issued this day that still have zero brokers on the books.
  officesIssuedNoBrokers Int @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([date])
  @@map("daily_stats")
}

/// Key/value store for sync bookkeeping (high-water card number, last full sync).
model SyncState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("sync_state")
}

// ---------------------------------------------------------------------------
// DLD open-data projects.
//
// Unlike /offices/ and /brokers/, POST /open-data/projects requires a calendar
// window and one of four date selectors. A project can match more than one
// selector, so the sync unions all four responses and stores `dateMatchTypes`
// to make the coverage explicit.
// ---------------------------------------------------------------------------

model Project {
  projectNumber String @id

  nameEn String?
  nameAr String?

  developerNumber String?
  developerNameEn String?
  developerNameAr String?

  startDate      DateTime? @db.Timestamptz(3)
  endDate        DateTime? @db.Timestamptz(3)
  /// DLD's project registration/adoption timestamp. This is the closest source
  /// field to a publication date and drives the "published" year/month views.
  adoptionDate   DateTime? @db.Timestamptz(3)
  inspectionDate DateTime? @db.Timestamptz(3)
  completionDate DateTime? @db.Timestamptz(3)

  projectTypeEn String?
  projectTypeAr String?
  projectValueAed Decimal? @db.Decimal(20, 2)
  escrowAccountNumber String?
  status String?
  percentCompleted Decimal? @db.Decimal(7, 2)

  descriptionEn String?
  descriptionAr String?
  areaEn String?
  areaAr String?
  zoneEn String?
  zoneAr String?
  masterProjectEn String?
  masterProjectAr String?

  totalLands     Int @default(0)
  totalBuildings Int @default(0)
  totalVillas    Int @default(0)
  totalUnits     Int @default(0)
  totalInventory Int @default(0)

  /// 1=start, 2=end, 3=adoption, 4=completion. A row may contain several.
  dateMatchTypes Int[]
  /// Calendar year used in the four required gateway date-window calls.
  sourceYear Int
  sourceHash String
  rawSource Json

  firstSeenAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([adoptionDate])
  @@index([startDate])
  @@index([endDate])
  @@index([completionDate])
  @@index([inspectionDate])
  @@index([status])
  @@index([areaEn])
  @@index([developerNumber])
  @@index([developerNameEn])
  @@index([projectTypeEn])
  @@index([sourceYear])
  @@map("projects")
}

model ProjectSyncRun {
  id String @id @default(cuid())
  /// MANUAL | SCHEDULED | API
  trigger String @default("MANUAL")
  /// RUNNING | SUCCESS | FAILED
  status String @default("RUNNING")
  sourceYear Int

  startedAt  DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  durationMs Int?

  projectsSeen    Int @default(0)
  projectsNew     Int @default(0)
  projectsUpdated Int @default(0)
  requestCount    Int @default(0)
  errorCount      Int @default(0)
  error           String?
  log             Json?

  @@index([startedAt])
  @@index([status])
  @@map("project_sync_runs")
}

// ---------------------------------------------------------------------------
// DLD open-data transactions (sales, mortgages, gifts).
//
// POST /open-data/transactions, same envelope as projects but a different
// parameter set. Quirks, all established by probing the live API:
//
//   - The parameter list is exactly:
//       P_FROM_DATE P_TO_DATE P_GROUP_ID P_IS_OFFPLAN P_IS_FREE_HOLD
//       P_AREA_ID P_USAGE_ID P_PROP_TYPE_ID P_TAKE P_SKIP P_SORT
//     Note P_PROP_TYPE_ID, *not* P_PROPERTY_TYPE_ID. Sending an unknown key,
//     or omitting one of these, returns responseCode 420 INVALID_REQUEST.
//   - P_TAKE / P_SKIP must be *strings*. Numbers bind but fail validation;
//     passing "" for an int filter crashes the upstream with an HTML 500.
//   - Dates are MM/DD/YYYY. The public form collects DD/MM/YYYY and converts.
//   - Both dates are mandatory - there is no "everything" call.
//
// IMPORTANT: this dataset has NO broker, agent, office or company attribution.
// The full field list is mirrored below; none of it identifies who brokered a
// deal. Transactions therefore CANNOT be joined to Office or Broker, and
// "how much has brokerage X sold" is not answerable from DLD open data. Do not
// add a relation to Office here - there is no key to build it on.
//
// EQUALLY IMPORTANT - multi-unit transactions and TRANS_VALUE:
//
// One transactionNumber can span many units. The gateway emits one row per
// unit, and each row repeats the *whole deal's* value in TRANS_VALUE. July 2026
// alone has 45 such transactions covering 429 extra rows, the largest spanning
// 12 units. Rows within a group differ only by unit detail (area, rooms,
// parking), and some are byte-identical to each other.
//
// So:
//   - SUM(transValueAed) over rows OVER-COUNTS. A 12-unit deal worth AED 1.48m
//     contributes AED 17.7m. Always aggregate value over DISTINCT
//     (transactionNumber, instanceDate, transValueAed) - see lib/analytics.
//   - COUNT(*) counts units, not deals. Count distinct transactionNumber +
//     instanceDate for deal counts.
//   - No subset of source fields identifies a row uniquely, which is why rows
//     carry a surrogate id and each month is replaced wholesale on sync rather
//     than upserted. See lib/dld/transactions-sync.ts.
// ---------------------------------------------------------------------------

model Transaction {
  /// Surrogate. The source has no row-unique natural key: byte-identical rows
  /// occur within multi-unit transactions, so any content-derived id would
  /// silently collapse real units. Rows are replaced per month, not upserted.
  id String @id @default(cuid())

  /// DLD's own reference, e.g. "101-2-2026" (<serial>-<group>-<year>).
  transactionNumber String
  instanceDate      DateTime? @db.Timestamptz(3)

  /// 1=Sales, 2=Mortgages, 3=Gifts.
  groupId   Int?
  groupEn   String?
  groupAr   String?
  procedureId Int?
  procedureEn String?
  procedureAr String?

  isOffplan     Boolean?
  isOffplanEn   String?
  isFreeHold    Boolean?
  isFreeHoldEn  String?

  usageId Int?
  usageEn String?
  usageAr String?

  areaId Int?
  areaEn String?
  areaAr String?

  propertyId        Int?
  parcelId          String?
  propertyTypeId    Int?
  propTypeEn        String?
  propTypeAr        String?
  propertySubTypeId Int?
  propSubTypeEn     String?
  propSubTypeAr     String?

  /// Headline consideration in AED.
  transValueAed Decimal? @db.Decimal(20, 2)
  /// Area the procedure covers vs the property's own area, both sq.m.
  procedureArea Decimal? @db.Decimal(14, 2)
  actualArea    Decimal? @db.Decimal(14, 2)

  roomsEn     String?
  roomsAr     String?
  parking     String?
  buildingAge Int?

  projectEn       String?
  projectAr       String?
  masterProjectEn String?
  masterProjectAr String?

  nearestMetroEn    String?
  nearestMallEn     String?
  nearestLandmarkEn String?

  totalBuyer  Int @default(0)
  totalSeller Int @default(0)

  /// Rows sharing this row's transactionNumber + instanceDate. 1 for the vast
  /// majority; up to 12 in July 2026.
  unitCount Int @default(1)
  /// Distinct transValueAed values within this deal. Almost always 1. Above 1
  /// means the source published several monetary legs for one transaction -
  /// in practice "Lease to Own Registration", where the property price and the
  /// financed portion are separate rows (e.g. AED 650,000 and AED 422,500 for
  /// the same 38 m² flat). 112 deals across May-July 2026.
  ///
  /// There is no source field marking which leg is the headline consideration,
  /// so `isPrimaryUnit` picks the largest. Filter on this column when that
  /// assumption matters to an analysis.
  dealValueVariants Int @default(1)
  /// True on exactly one row per deal - the one carrying the highest value.
  /// Computed at sync time so value and deal-count aggregates are a plain
  /// indexed WHERE rather than a SELECT DISTINCT every consumer must remember:
  ///   deals  = count(where isPrimaryUnit)
  ///   value  = sum(transValueAed where isPrimaryUnit)
  ///   units  = count(*)
  /// Aggregating value without this filter over-counts every multi-unit deal.
  isPrimaryUnit Boolean @default(true)

  /// Calendar month window (YYYY-MM) this row was fetched under. The endpoint
  /// only answers date-bounded queries, so coverage is tracked per month and
  /// a re-sync replaces the month wholesale.
  sourceMonth String
  /// sha256 of the row's stable content. Not unique - see the header note on
  /// multi-unit transactions - but lets a re-sync report what actually moved.
  sourceHash  String
  rawSource   Json

  syncedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([transactionNumber])
  @@index([instanceDate])
  @@index([groupId])
  @@index([areaEn])
  @@index([propTypeEn])
  @@index([projectEn])
  @@index([transValueAed])
  @@index([sourceMonth])
  @@index([isOffplan])
  @@index([isPrimaryUnit])
  @@index([isPrimaryUnit, instanceDate])
  @@map("transactions")
}

model TransactionSyncRun {
  id String @id @default(cuid())
  /// MANUAL | SCHEDULED | API
  trigger String @default("MANUAL")
  /// RUNNING | SUCCESS | FAILED
  status String @default("RUNNING")

  /// Inclusive YYYY-MM window this run covered.
  fromMonth String
  toMonth   String

  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  durationMs Int?

  /// Rows written (units), and the deal count they collapse to.
  transactionsSeen    Int @default(0)
  transactionsNew     Int @default(0)
  transactionsUpdated Int @default(0)
  /// Distinct transactionNumber + instanceDate pairs across the window.
  dealsSeen           Int @default(0)
  requestCount        Int @default(0)
  errorCount          Int @default(0)
  error               String?
  log                 Json?

  @@index([startedAt])
  @@index([status])
  @@map("transaction_sync_runs")
}

// ---------------------------------------------------------------------------
// The rest of the DLD open-data catalogue.
//
// Nine commands share one envelope; see lib/dld/open-data.ts for the transport
// and its quirks. Volumes and fetch strategy, measured 2026-08-07:
//
//   rents       95,365 / month   monthly single-shot
//   lands      260,730 total     paged (page overlap verified zero)
//   buildings    9,845 total     single-shot, blank dates = whole catalogue
//   brokers     42,997 total     single-shot, 22.4MB in 16.5s
//   developers     182 total     single-shot, needs a wide date window
//   valuations     470 / month   monthly single-shot
//   units            0           answers 200 but returns nothing, every filter
//
// JOINING THESE IS NOT DONE ON IDs. The gateway zeroes most identifier columns
// - AREA_ID, PROPERTY_ID, USAGE_ID, PROPERTY_TYPE_ID and friends all come back
// as 0 in the data rows even though the lookup dictionaries carry real values.
// The keys that survive, and are therefore the only safe join columns, are:
//
//   areaEn / projectEn / masterProjectEn   names, not ids
//   parcelId, landNumber                   land + building + rent + transaction
//   projectNumber                          land + building -> Project
//   developerNumber                        Developer -> Project.developerNumber
//   brokerNumber                           OpenDataBroker -> Broker.cardNumber
//   contractNumber, transactionNumber      within their own dataset
//
// Every model below keeps `rawSource` so a mapping we have not thought of yet
// can be recovered without a re-crawl.
// ---------------------------------------------------------------------------

/// Ejari rental contracts. One row per contract version - a renewal is a new
/// row sharing contractNumber with a higher versionNumber.
model Rent {
  id String @id @default(cuid())

  contractNumber String?
  versionNumber  Int?
  versionEn      String?

  registrationDate DateTime? @db.Timestamptz(3)
  startDate        DateTime? @db.Timestamptz(3)
  endDate          DateTime? @db.Timestamptz(3)

  /// Whole-term consideration vs the annualised figure. Compare `annualAmount`
  /// against transaction values for yield work; `contractAmount` covers a
  /// multi-year term and is not directly comparable.
  contractAmountAed Decimal? @db.Decimal(20, 2)
  annualAmountAed   Decimal? @db.Decimal(20, 2)

  areaEn String?
  areaAr String?

  propTypeEn    String?
  propSubTypeEn String?
  usageEn       String?
  rooms         String?
  parking       String?
  actualArea    Decimal? @db.Decimal(14, 2)

  isFreeHold   Boolean?
  isFreeHoldEn String?

  projectEn       String?
  masterProjectEn String?

  nearestMetroEn    String?
  nearestMallEn     String?
  nearestLandmarkEn String?

  /// Property-side keys. propertyId is usually zeroed; parcelId is not.
  propertyId     Int?
  parcelId       String?
  landPropertyId Int?
  /// Properties covered by this contract - >1 means a portfolio lease.
  totalProperties Int @default(1)

  sourceMonth String
  sourceHash  String
  rawSource   Json

  syncedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([contractNumber])
  @@index([registrationDate])
  @@index([startDate])
  @@index([areaEn])
  @@index([projectEn])
  @@index([parcelId])
  @@index([annualAmountAed])
  @@index([sourceMonth])
  @@index([propSubTypeEn])
  @@map("rents")
}

/// The land parcel register. Static catalogue, re-pulled whole.
model Land {
  id String @id @default(cuid())

  /// Municipality parcel identifier. The most reliable cross-dataset key.
  parcelId       String?
  landNumber     String?
  landSubNumber  Int?
  municipalityNumber String?
  dmZipCode      String?

  projectNumber   String?
  projectEn       String?
  masterProjectEn String?

  landTypeEn    String?
  propSubTypeEn String?
  areaEn        String?
  areaAr        String?
  zoneEn        String?

  actualArea Decimal? @db.Decimal(16, 2)

  isFreeHold   Boolean?
  isOffplanEn  String?
  isRegistered Boolean?

  preRegistrationNumber String?
  separatedFrom         String?

  sourceHash String
  rawSource  Json

  syncedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([parcelId])
  @@index([landNumber])
  @@index([projectNumber])
  @@index([projectEn])
  @@index([areaEn])
  @@index([zoneEn])
  @@index([landTypeEn])
  @@map("lands")
}

/// The building register: physical stock, with unit and amenity counts.
model Building {
  id String @id @default(cuid())

  buildingNumber String?
  parcelId       String?
  landNumber     String?
  landSubNumber  Int?

  projectNumber   String?
  projectEn       String?
  masterProjectEn String?

  areaEn String?
  zoneEn String?

  propSubTypeEn String?
  landTypeEn    String?

  /// Composition. These are what make the building register useful: they say
  /// how much sellable stock a project actually contains.
  floors        Int?
  buildingLevels Int?
  flats         Int?
  shops         Int?
  offices       Int?
  rooms         Int?
  carParks      Int?
  elevators     Int?
  swimmingPools Int?

  actualArea      Decimal? @db.Decimal(16, 2)
  builtUpArea     Decimal? @db.Decimal(16, 2)
  commonArea      Decimal? @db.Decimal(16, 2)
  actualCommonArea Decimal? @db.Decimal(16, 2)

  creationDate DateTime? @db.Timestamptz(3)

  isFreeHold   Boolean?
  isLeaseHold  Boolean?
  isRegistered Boolean?
  isOffplanEn  String?

  preRegistrationNumber String?

  sourceHash String
  rawSource  Json

  syncedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([buildingNumber])
  @@index([parcelId])
  @@index([projectNumber])
  @@index([projectEn])
  @@index([areaEn])
  @@index([creationDate])
  @@map("buildings")
}

/// Broker cards as published by open data.
///
/// Deliberately separate from `Broker`, which mirrors the registry `/brokers/`
/// endpoint. This set is larger (42,997 vs ~34,000) because it RETAINS EXPIRED
/// LICENCES - the registry drops a card the day it lapses. It is the only way
/// to see a broker or firm after DLD delists them, so it is the basis for any
/// churn or lapsed-licence analysis. Join to `Broker` on brokerNumber =
/// cardNumber, and to `Office` on realEstateNumber.
model OpenDataBroker {
  brokerNumber String @id

  nameEn   String?
  nameAr   String?
  genderEn String?

  licenseStartDate DateTime? @db.Timestamptz(3)
  licenseEndDate   DateTime? @db.Timestamptz(3)

  phone   String?
  fax     String?
  webpage String?

  realEstateNumber String?
  officeNameEn     String?
  officeNameAr     String?

  /// True when licenseEndDate is in the past at sync time - i.e. this card is
  /// in the open-data set but gone from the live registry.
  isExpired Boolean @default(false)

  sourceHash String
  rawSource  Json

  syncedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([realEstateNumber])
  @@index([nameEn])
  @@index([licenseEndDate])
  @@index([isExpired])
  @@map("od_brokers")
}

/// Registered developers. Joins to `Project.developerNumber`.
model Developer {
  developerNumber String @id

  nameEn String?
  nameAr String?

  registrationDate  DateTime? @db.Timestamptz(3)
  licenseNumber     String?
  licenseIssueDate  DateTime? @db.Timestamptz(3)
  licenseExpiryDate DateTime? @db.Timestamptz(3)
  licenseSourceEn   String?
  licenseTypeEn     String?
  legalStatusEn     String?

  chamberOfCommerceNo String?
  phone   String?
  fax     String?
  webpage String?

  sourceHash String
  rawSource  Json

  syncedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([nameEn])
  @@index([registrationDate])
  @@index([licenseExpiryDate])
  @@map("developers")
}

/// DLD valuation procedures - an official worth assessment, distinct from a
/// sale price. Useful as a market-rate benchmark against transaction values.
model Valuation {
  id String @id @default(cuid())

  procedureYear   Int?
  procedureNumber String?
  instanceDate    DateTime? @db.Timestamptz(3)

  propertyId Int?

  propertyTypeEn String?
  propSubTypeEn  String?
  areaEn         String?
  areaAr         String?

  actualArea    Decimal? @db.Decimal(16, 2)
  procedureArea Decimal? @db.Decimal(16, 2)

  actualWorthAed        Decimal? @db.Decimal(20, 2)
  propertyTotalValueAed Decimal? @db.Decimal(20, 2)

  rowStatusCode String?

  sourceMonth String
  sourceHash  String
  rawSource   Json

  syncedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([procedureYear, procedureNumber])
  @@index([instanceDate])
  @@index([areaEn])
  @@index([propertyTypeEn])
  @@index([sourceMonth])
  @@map("valuations")
}

/// Unit register. The endpoint answers 200 with an empty result under every
/// filter combination tried on 2026-08-07, so this table may stay empty; it
/// exists so a sync starts storing the moment DLD populates the dataset.
model Unit {
  id String @id @default(cuid())

  parcelId   String?
  areaEn     String?
  zoneEn     String?
  projectEn  String?

  propSubTypeEn String?
  actualArea    Decimal? @db.Decimal(16, 2)

  isFreeHold  Boolean?
  isLeaseHold Boolean?
  isOffplanEn String?

  sourceHash String
  rawSource  Json

  syncedAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([parcelId])
  @@index([areaEn])
  @@index([projectEn])
  @@map("units")
}

// ---- lookup dictionaries -------------------------------------------------
// These carry the real ids the data rows have zeroed out. They cannot repair
// a row's masked AREA_ID, but they do give the canonical name list to
// normalise `areaEn` spellings against, and `projects-lookup` enumerates 4,162
// projects against the 815 the year-windowed project sync stores.

model AreaLookup {
  areaId String @id
  nameEn String?
  nameAr String?
  syncedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([nameEn])
  @@map("lookup_areas")
}

model ProjectLookup {
  projectId String @id
  nameEn String?
  nameAr String?
  syncedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([nameEn])
  @@map("lookup_projects")
}

model EjariPropertyType {
  typeId String @id
  nameEn String?
  nameAr String?
  syncedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("lookup_ejari_property_types")
}

/// One run of any open-data dataset sync. Replaces per-dataset run tables so
/// the sync page has a single history to render.
model OpenDataSyncRun {
  id String @id @default(cuid())
  /// transactions | rents | lands | buildings | units | brokers | developers |
  /// valuations | lookups
  dataset String
  /// MANUAL | SCHEDULED | API
  trigger String @default("MANUAL")
  /// RUNNING | SUCCESS | FAILED | PARTIAL
  status  String @default("RUNNING")

  /// Inclusive YYYY-MM window, null for datasets with no date dimension.
  fromMonth String?
  toMonth   String?

  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  durationMs Int?

  rowsSeen    Int @default(0)
  rowsWritten Int @default(0)
  rowsNew     Int @default(0)
  rowsRemoved Int @default(0)
  /// What the gateway said the window contained, for reconciliation.
  reportedTotal Int @default(0)

  requestCount Int @default(0)
  retryCount   Int @default(0)
  errorCount   Int @default(0)
  bytesFetched BigInt @default(0)
  error        String?
  log          Json?

  @@index([dataset, startedAt])
  @@index([status])
  @@index([startedAt])
  @@map("open_data_sync_runs")
}

// ---------------------------------------------------------------------------
// CRM: batching, targets and the Notion mirror.
//
// Postgres is the system of record for everything the registry tells us and for
// all batch/target bookkeeping. Notion is the surface humans work on. The
// contract between them lives in docs/CRM_PROTOCOL.md — read it before changing
// anything here.
// ---------------------------------------------------------------------------

/// A day's worth of outreach for one person: ~25 leads, one owner, one due date.
///
/// Batches are cut automatically from the highest-scoring unbatched leads, so
/// the team always works the freshest, most promising firms first rather than
/// whatever happens to be at the top of a list.
model Batch {
  id   String @id @default(cuid())
  /// Human-readable stable key, e.g. BRG-2026-W31-01. Also the Notion title.
  code String @unique

  /// BROKERAGE | BROKER
  kind String
  /// Queued | In Progress | Completed | Delayed | Cancelled. Humans own this in
  /// Notion; the sync only forces Delayed/Completed when the facts demand it.
  status String @default("Queued")

  size   Int @default(0)
  worked Int @default(0)

  /// Dominant lead tier across the batch (A+/A/B/C/Mixed).
  priorityBand String?
  avgLeadScore Int?

  assignedName         String?
  assignedNotionUserId String?

  assignedDate  DateTime  @db.Timestamptz(3)
  /// assignedDate + SLA working days. Every delay figure derives from this.
  dueDate       DateTime  @db.Timestamptz(3)
  completedDate DateTime? @db.Timestamptz(3)

  /// Whole days past dueDate while still unfinished. 0 when on track.
  daysOverdue Int @default(0)
  /// Delay inherited from the previous unfinished batch in the same lane. This
  /// is what surfaces "delayed on top of delayed" rather than showing each
  /// batch as independently a day late.
  cascadeDelayDays Int @default(0)
  /// On Track | Due Today | Overdue | Critically Overdue | Done On Time | Done Late
  delayStatus      String @default("On Track")

  blockedByBatchId String?
  blockedBy        Batch?  @relation("BatchChain", fields: [blockedByBatchId], references: [id], onDelete: SetNull)
  blocks           Batch[] @relation("BatchChain")

  notes String?

  notionPageId   String?   @unique
  notionSyncedAt DateTime? @db.Timestamptz(3)
  notionHash     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  offices Office[]
  brokers Broker[]

  @@index([kind, status])
  @@index([dueDate])
  @@index([delayStatus])
  @@index([assignedDate])
  @@map("batches")
}

/// Daily / weekly / monthly goals. Targets are set by humans in Notion; actuals
/// are counted here and pushed back, so attainment is never hand-maintained.
model Target {
  id String @id @default(cuid())
  /// 2026-07-27 (daily) | 2026-W31 (weekly) | 2026-07 (monthly).
  periodKey String @unique
  /// DAILY | WEEKLY | MONTHLY
  kind      String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  targetTouches  Int @default(0)
  actualTouches  Int @default(0)
  targetBatches  Int @default(0)
  actualBatches  Int @default(0)
  targetReplies  Int @default(0)
  actualReplies  Int @default(0)
  targetMeetings Int @default(0)
  actualMeetings Int @default(0)

  /// On Track | At Risk | Behind | Hit | Missed | Upcoming
  status String @default("Upcoming")
  notes  String?

  notionPageId   String?   @unique
  notionSyncedAt DateTime? @db.Timestamptz(3)
  notionHash     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([kind, startDate])
  @@index([status])
  @@map("targets")
}

/// Audit of every Notion push/pull, mirroring SyncRun for the registry crawl.
model NotionSyncRun {
  id      String @id @default(cuid())
  /// FULL | PUSH | PULL
  kind    String
  /// RUNNING | SUCCESS | FAILED | PARTIAL
  status  String @default("RUNNING")
  /// MANUAL | SCHEDULED | API
  trigger String @default("MANUAL")

  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  durationMs Int?

  batchesCreated Int @default(0)
  pushedOffices  Int @default(0)
  pushedBrokers  Int @default(0)
  pushedBatches  Int @default(0)
  pushedTargets  Int @default(0)
  pulledOffices  Int @default(0)
  pulledBrokers  Int @default(0)
  pulledBatches  Int @default(0)
  skipped        Int @default(0)

  requestCount Int     @default(0)
  errorCount   Int     @default(0)
  error        String?
  log          Json?

  @@index([startedAt])
  @@index([status])
  @@map("notion_sync_runs")
}
