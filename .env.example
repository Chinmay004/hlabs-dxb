DATABASE_URL="postgresql://user:password@localhost:5432/hlabsdxb?schema=public"

# Public consumer key the DLD gateway expects. Overridable in case it rotates.
DLD_CONSUMER_ID="gkb3WvEG0rY9eilwXC0P2pTz8UzvLj9F"

# Shared secret for POST /api/sync so the scheduled job can trigger a run.
SYNC_SECRET="change-me"

# ---------------------------------------------------------------------------
# Dubai Pulse. Optional, and the ONLY source of pre-2026 history: the DLD
# gateway serves the current calendar year only. There is no anonymous access -
# register at https://www.dubaipulse.gov.ae, request the DLD datasets, and DLD
# emails an API Key and API Secret separately. Verify with:
#   npx tsx scripts/pulse-discover.ts
# ---------------------------------------------------------------------------
# DUBAI_PULSE_KEY=""
# DUBAI_PULSE_SECRET=""

# Per-office roster reconcile — the slow stage of a sync, ~1s per brokerage.
# Defaults shown; raise the window/cap for more completeness, lower for speed.
# RECONCILE_WINDOW_DAYS=180
# RECONCILE_MAX_OFFICES=1200
# RECONCILE_CONCURRENCY=12

# ---------------------------------------------------------------------------
# Notion CRM. Required for `npm run crm`. See docs/NOTION_INTEGRATION.md.
# Create an internal integration at https://www.notion.so/my-integrations and
# share the "Homeey DXB CRM" page with it, or every call 404s.
# ---------------------------------------------------------------------------
NOTION_TOKEN="ntn_replace_me"

# Database IDs default to the live CRM; override only if you rebuild one.
# NOTION_DB_BROKERAGES="8c219ef5-cf6e-417a-8923-a0fb9786bf9b"
# NOTION_DB_BROKERS="54d4974a-39f0-4cfb-99f1-93b4165bd8cf"
# NOTION_DB_BATCHES="495c35fc-1a8d-484e-9aaf-01de1609cf36"
# NOTION_DB_TARGETS="be966f82-7a4a-4828-bf23-00799888d302"
# NOTION_DB_ACTIVITY="451e6953-eab9-4c6b-b3dd-87647aba2a12"
# NOTION_PARENT_PAGE="3aa72683-9438-81f7-8f05-f8785cb4230d"

# Notion allows ~3 req/s. Lower the interval only if you enjoy 429s.
# NOTION_MIN_INTERVAL_MS=340
# NOTION_PUSH_LIMIT=400

# ---------------------------------------------------------------------------
# Batching and targets. See docs/CRM_PROTOCOL.md.
# ---------------------------------------------------------------------------
# BATCH_SIZE=25                 # leads per batch = one person's day
# QUEUE_DEPTH_BROKERAGE=4       # batches kept queued ahead of the team
# QUEUE_DEPTH_BROKER=2
# BATCH_SLA_DAYS=1              # working days before a batch counts as late
# BATCH_CRITICAL_DAYS=3         # days late before it escalates to critical
# MIN_LEAD_SCORE_BROKERAGE=40
# MIN_LEAD_SCORE_BROKER=35
# TARGET_DAILY_TOUCHES=25
# TARGET_DAILY_BATCHES=1
# TARGET_DAILY_REPLIES=3
# TARGET_DAILY_MEETINGS=1
# TARGET_HORIZON_DAYS=14
